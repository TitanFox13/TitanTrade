# Alpaca Markets — Paper Trading (required)
ALPACA_PAPER_KEY=your_paper_key_here
ALPACA_PAPER_SECRET=your_paper_secret_here

# Alpaca Markets — Live Trading (optional, enable via PUT /api/settings/mode)
ALPACA_LIVE_KEY=your_live_key_here
ALPACA_LIVE_SECRET=your_live_secret_here

# Market data — Alpaca (bars/quotes/news) uses the ALPACA keys above (free).

# FRED — St. Louis Fed (free key): economic-release calendar for the macro blackout gate.
# Get one at https://fredaccount.stlouisfed.org/apikeys
FRED_KEY=your_fred_api_key_here

# Finnhub (free tier): earnings dates (blackout gate), sector, analyst recommendations (curator).
# Get one at https://finnhub.io/register
FINNHUB_KEY=your_finnhub_api_key_here

# Anthropic Claude (monthly universe curator — the only LLM call; places no orders)
CLAUDE_KEY=your_claude_api_key_here
# CLAUDE_MODEL=claude-opus-4-8  # Optional model override

# Cloudflare Tunnel (routes trade.praguefun.cz → API container)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Discord Notifications (optional — enables job alerts and daily summary)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# Optional overrides
# LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
