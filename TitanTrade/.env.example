# Alpaca Markets — Paper Trading (required)
ALPACA_PAPER_KEY=your_paper_key_here
ALPACA_PAPER_SECRET=your_paper_secret_here

# Alpaca Markets — Live Trading (optional, enable via app toggle)
ALPACA_LIVE_KEY=your_live_key_here
ALPACA_LIVE_SECRET=your_live_secret_here

# Financial Modeling Prep
FMP_KEY=your_fmp_key_here

# SEC EDGAR (free — just requires a descriptive User-Agent with contact email)
# Set this to identify your app per SEC policy: https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=TitanTrade/1.0 (your_email@example.com)

# Anthropic Claude (Weekly Analyst)
CLAUDE_KEY=your_claude_api_key_here
# CLAUDE_MODEL=claude-sonnet-4-6-20250514  # Optional model override

# Google Gemini (Daily Sentry)
GEMINI_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash  # Optional model override

# Cloudflare Tunnel (routes trade.praguefun.cz → API container)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Discord Notifications (optional — enables job alerts and daily summary)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# Optional overrides
# LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
