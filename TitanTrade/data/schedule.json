{
  "timezone": "America/New_York",
  "jobs": [
    {
      "id": "sunday_full",
      "name": "Weekly Full Pipeline (fetch \u2192 signals \u2192 execute)",
      "command": "full",
      "cron": {
        "day_of_week": "sun",
        "hour": 16,
        "minute": 0
      },
      "enabled": true
    },
    {
      "id": "monthly_curate",
      "name": "Monthly Universe Review + Post-Mortem (LLM, no orders) \u2014 retired from the schedule, Decision 082",
      "command": "curate",
      "cron": {
        "day_of_week": "sun",
        "day": "1-7",
        "hour": 15,
        "minute": 0
      },
      "enabled": false
    },
    {
      "id": "weekday_fetch",
      "name": "Daily Data Bundle Refresh",
      "command": "fetch",
      "cron": {
        "day_of_week": "mon-fri",
        "hour": 9,
        "minute": 0
      },
      "enabled": true
    },
    {
      "id": "weekday_gapcheck",
      "name": "Gap-Down Check + Stop Coverage",
      "command": "gapcheck",
      "cron": {
        "day_of_week": "mon-fri",
        "hour": 9,
        "minute": 35
      },
      "enabled": true
    },
    {
      "id": "weekday_execute_morning",
      "name": "Morning Signals + Execute",
      "command": "execute",
      "cron": {
        "day_of_week": "mon-fri",
        "hour": 10,
        "minute": 15
      },
      "enabled": true
    },
    {
      "id": "weekday_execute_preclose",
      "name": "Pre-Close Signals + Execute",
      "command": "execute",
      "cron": {
        "day_of_week": "mon-fri",
        "hour": 15,
        "minute": 30
      },
      "enabled": true
    },
    {
      "id": "daily_summary",
      "name": "Daily Portfolio Summary",
      "command": "daily_summary",
      "cron": {
        "day_of_week": "mon-fri",
        "hour": 16,
        "minute": 30
      },
      "enabled": true
    }
  ]
}
